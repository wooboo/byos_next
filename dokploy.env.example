# Image built and pushed by .github/workflows/release.yml.
APP_IMAGE=ghcr.io/wooboo/byos_next:latest

# Public port exposed by docker-compose.dokploy.yml.
# In Dokploy this can stay internal if you attach the app to Dokploy's proxy.
APP_PORT=3001

# Database lives in a separate Dokploy service, e.g. `byos-next-postgres`.
# Use the hostname/network name exposed by that Dokploy service.
DATABASE_URL=postgres://postgres:change-me@byos-next-postgres:5432/byos_db?sslmode=disable

# Public URL handled by Dokploy/reverse proxy.
BETTER_AUTH_URL=https://byos.example.com
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# App settings.
AUTH_ENABLED=true
REACT_RENDERER=takumi
ENABLE_EXTERNAL_CATALOG=false
TRMNL_PROXY_LIVE=false

# Add public hostnames if Server Actions are rejected behind a proxy.
# Example: byos.example.com
ALLOWED_SERVER_ACTION_ORIGINS=
